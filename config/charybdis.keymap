#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        arrow_function: arrow_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp T &kp SPACE &kp SPACE &kp EQUAL &kp SPACE &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp SEMI>;
            label = "ARROW_FUNCTION";
        };

        interface: interface {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp N &kp T &kp E &kp R &kp F &kp A &kp C &kp E &kp SPACE &kp LS(F) &kp O &kp O &kp SPACE &kp LBRC &kp RET &kp SPACE &kp SPACE &kp B &kp A &kp R &kp COLON &kp SPACE &kp S &kp T &kp R &kp I &kp N &kp G &kp SEMI &kp RET &kp RBRC>;
            label = "INTERFACE";
        };

        type: type {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp Y &kp P &kp E &kp SPACE &kp LS(F) &kp O &kp O &kp SPACE &kp EQUAL &kp SPACE &kp S &kp T &kp R &kp I &kp N &kp G &kp SEMI>;
            label = "TYPE";
        };

        ref: ref {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp T &kp SPACE &kp F &kp O &kp O &kp SPACE &kp EQUAL &kp SPACE &kp R &kp E &kp F &kp LPAR &kp RPAR &kp SEMI>;
            label = "REF";
        };

        computed: computed {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp T &kp SPACE &kp F &kp O &kp O &kp SPACE &kp EQUAL &kp SPACE &kp C &kp O &kp M &kp P &kp U &kp T &kp E &kp D &kp LPAR &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp SQT &kp B &kp A &kp R &kp SQT &kp RPAR &kp SEMI>;
            label = "COMPUTED";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4          &kp N5         &kp N6       &kp N7     &kp N8     &kp N9   &kp N0     &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R           &kp T          &kp Y        &kp U      &kp I      &kp O    &kp P      &kp NON_US_BACKSLASH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F           &kp G          &kp H        &kp J      &kp K      &kp L    &kp SEMI   &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V           &kp B          &kp N        &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp MINUS
                                &kp LEFT_WIN  &lt 1 CAPSLOCK  &lt 2 SPACE    &lt 3 ENTER  &kp EQUAL
                                              &mkp LCLK       &mkp RCLK      &kp DELETE
            >;
        };

        Number {
            bindings = <
&kp F1     &kp F2         &kp F3     &kp F4        &kp F5                &kp F6                  &kp KP_NUMLOCK  &kp SLASH     &kp ASTERISK  &kp MINUS  &kp LESS_THAN         &kp RS(GREATER_THAN)
&kp F7     &kp F8         &kp F9     &kp F10       &kp F11               &kp F12                 &kp N7          &kp N8        &kp N9        &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LSHFT  &kp LG(LS(N))  &kp LG(N)  &kp LG(T)     &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))    &kp NUMBER_4    &kp N5        &kp NUMBER_6  &kp PLUS   &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp LG(Z)  &kp LG(A)      &kp LG(F)  &kp LG(X)     &kp LG(C)             &kp LG(Z)               &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp ENTER  &kp LEFT_BRACE        &kp RIGHT_BRACE
                                     &kp LEFT_WIN  &kp SPACE             &kp ESC                 &kp ENTER       &kp N0
                                                   &none                 &none                   &none
            >;
        };

        Macro {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3        &kp F4      &kp F5             &kp F6             &kp F7         &kp F8    &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)    &kp LS(N4)  &kp LS(LBKT)       &kp LS(RBKT)       &none          &none     &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp LS(N7)    &kp LS(N8)  &none              &kp LS(BACKSLASH)  &none          &kp UP    &none      &none    &none
&kp LC(C)      &interface  &type       &ref          &computed   &arrow_function    &none              &kp LEFT       &kp DOWN  &kp RIGHT  &none    &none
                                       &kp LEFT_WIN  &kp SPACE   &kp ENTER          &trans             &kp RIGHT_ALT
                                                     &none       &none              &none
            >;
        };

        Bluetooth {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &trans        &mkp LCLK  &none         &none       &mkp LCLK  &trans        &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };
    };
};
